#!/usr/bin/env bash
# EcoMind pre-push hook — 自动验证 + 文档同步
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "▶ Pre-push: 烟雾测试..."
if bash "$REPO_ROOT/scripts/smoke.sh" > /dev/null 2>&1; then
  echo "✅ 烟雾测试通过"
else
  echo "❌ 烟雾测试失败 — 推送被阻止"
  exit 1
fi

echo "▶ Pre-push: 自动更新文档..."
if python3 "$REPO_ROOT/scripts/auto-doc.py" 2>/dev/null; then
  # 如果文档有更新，自动提交
  if ! git diff --quiet README.md CODE_WIKI.md DESIGN.md 2>/dev/null; then
    git add README.md CODE_WIKI.md DESIGN.md 2>/dev/null
    git commit -m "docs: auto-sync from code scan" 2>/dev/null || true
    echo "✅ 文档已自动更新"
  else
    echo "✅ 文档无需更新"
  fi
else
  echo "⚠️  文档自动更新跳过 (python3 or deps missing)"
fi
