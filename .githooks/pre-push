#!/usr/bin/env bash
# EcoMind pre-push hook — 自动验证后再推送
set -euo pipefail

echo "▶ Pre-push: 运行烟雾测试..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if bash "$REPO_ROOT/scripts/smoke.sh" > /dev/null 2>&1; then
  echo "✅ 烟雾测试通过 — 允许推送"
else
  echo "❌ 烟雾测试失败 — 推送被阻止"
  exit 1
fi
