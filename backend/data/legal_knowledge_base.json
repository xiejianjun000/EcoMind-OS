    "level": "部门规章",
    "issue_number": "环发〔2015〕175号",
    "effective_date": "2015年12月",
    "key_articles": [
      {
        "article": "第四条",
        "content": "定义了14种篡改监测数据的情形，包括擅自改动监测参数、故意不正常运行监测设备、破坏监测系统功能等。",
        "related_rules": [
          "R001",
          "R002",
          "R049",
          "R050",
          "R051",
          "R052",
          "R053"
        ]
      },
      {
        "article": "第五条",
        "content": "定义了8种伪造监测数据的情形，包括未开展监测出具数据、隐瞒部分监测数据、出具虚假监测报告等。",
        "related_rules": [
          "R054",
          "R055",
          "R056"
        ]
      },
      {
        "article": "第六条",
        "content": "定义了5种指使造假的情形，包括排污单位指使监测机构造假、生态环境部门工作人员指使造假等。",
        "related_rules": [
          "R057",
          "R058"
        ]
      },
      {
        "article": "第八条",
        "content": "对弄虚作假行为的处理措施，包括责令改正、罚款、移送公安机关等。",
        "related_rules": [
