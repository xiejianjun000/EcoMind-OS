  {
    "id": "LAW-007",
    "name": "生态环境监测条例",
    "type": "regulation",
    "level": "行政法规",
    "issue_number": "国务院令第820号",
    "effective_date": "2026年1月1日",
    "key_articles": [
      {
        "article": "第十七条",
        "content": "监测机构及其负责人对监测数据的真实性和准确性负责。任何单位和个人不得授意、指使、强令监测机构篡改、伪造监测数据。",
        "related_rules": [
          "R004",
          "R005",
          "R034"
        ]
      },
      {
        "article": "第二十一条",
        "content": "排污单位应当按照国家有关规定和监测规范开展自行监测，保存原始监测记录，不得篡改、伪造监测数据。",
        "related_rules": [
          "R001",
          "R035"
        ]
      },
      {
        "article": "第三十条",
        "content": "篡改、伪造监测数据的，由生态环境主管部门责令改正，处以罚款；情节严重的，责令停产整治，并处相应罚款。",
        "related_rules": [
          "R006",
          "R007",
          "R008",
          "R036"
        ]
      }
    ],
    "tags": [
