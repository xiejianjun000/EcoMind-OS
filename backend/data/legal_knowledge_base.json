  {
    "id": "LAW-008",
    "name": "排污许可管理条例",
    "type": "regulation",
    "level": "行政法规",
    "issue_number": "国务院令第736号",
    "effective_date": "2021年3月1日",
    "key_articles": [
      {
        "article": "第十九条",
        "content": "排污单位应当按照排污许可证规定和有关标准规范，依法开展自行监测，并保存原始监测记录。原始监测记录保存期限不得少于五年。",
        "related_rules": [
          "R037",
          "R038"
        ]
      },
      {
        "article": "第二十条",
        "content": "实行排污许可重点管理的排污单位，应当依法安装、使用、维护污染物排放自动监测设备，并与生态环境主管部门的监控设备联网。",
        "related_rules": [
          "R039",
          "R040"
        ]
      },
      {
        "article": "第三十六条",
        "content": "违反本条例规定，未按照排污许可证规定开展自行监测、未保存原始监测记录或者弄虚作假的，由生态环境主管部门责令改正，处以罚款。",
        "related_rules": [
          "R041",
          "R042"
        ]
      }
    ],
    "tags": [
      "排污许可",
      "自行监测",
