[
  {
    "id": "LAW-001",
    "name": "中华人民共和国生态环境法典",
    "type": "law",
    "level": "国家法律",
    "issue_number": "中华人民共和国主席令",
    "effective_date": "2026年",
    "key_articles": [
      {
        "article": "第八十条",
        "content": "排污单位应当按照国家有关规定和监测规范安装使用监测设备，保证监测设备正常运行，保存原始监测记录，不得篡改、伪造监测数据。",
        "related_rules": [
          "R001",
          "R002",
          "R003",
          "R004",
          "R005"
        ]
      },
      {
        "article": "第一百六十四条",
        "content": "违反本法规定，篡改、伪造监测数据的，由生态环境主管部门责令改正，处以罚款；情节严重的，责令停产整治。",
        "related_rules": [
          "R006",
          "R007",
          "R008"
        ]
      }
    ],
    "tags": [
