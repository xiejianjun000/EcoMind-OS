  {
    "id": "LAW-009",
    "name": "关于办理环境污染刑事案件适用法律若干问题的解释",
    "type": "regulation",
    "level": "司法解释",
    "issue_number": "法释〔2023〕7号（2026年修正）",
    "effective_date": "2026年修正版",
    "key_articles": [
      {
        "article": "第一条",
        "content": "明确'严重污染环境'的认定标准，包括篡改、伪造监测数据排放污染物等情形。",
        "related_rules": [
          "R043",
          "R044"
        ]
      },
      {
        "article": "第七条",
        "content": "重点排污单位篡改、伪造自动监测数据或者干扰自动监测设施，排放化学需氧量、氨氮、二氧化硫、氮氧化物等污染物的，应当认定为'严重污染环境'。",
        "related_rules": [
          "R045",
          "R046",
          "R047"
        ]
      },
      {
        "article": "第十条",
        "content": "明知他人无危险废物经营许可证，向其提供或者委托其收集、贮存、利用、处置危险废物，严重污染环境的，以共同犯罪论处。",
        "related_rules": [
          "R048"
        ]
      }
    ],
