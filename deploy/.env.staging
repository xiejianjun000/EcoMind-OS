# ============================================
# EcoMind OS Staging 环境配置
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.staging .env
# ============================================

# ─── 服务器配置 ───
HOST=0.0.0.0
PORT=8000

# ─── CORS 配置 ───
# 允许的前端域名列表 (逗号分隔)
CORS_ORIGINS=https://staging.ecomind.example.com,http://localhost:5173,http://127.0.0.1:5173

# ─── API 密钥 ───
# 用于内部服务认证和 API 访问控制
API_KEY=your-api-key-here

# ─── 日志级别 ───
# 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── 数据库连接 ───
# SQLite (开发/测试默认)
DATABASE_URL=sqlite:///./data/ecomind_staging.db

# PostgreSQL (生产环境推荐，取消注释并修改)
# DATABASE_URL=postgresql://user:password@db:5432/ecomind_staging

# ─── AI 模型配置 ───
# DeepSeek API 密钥 (用于 Chat 推理)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DeepSeek API 基础 URL (可选，用于代理或私有化部署)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── 文件上传配置 ───
# 上传文件最大大小 (字节)
UPLOAD_MAX_SIZE=52428800  # 50MB

# 上传文件存储路径
UPLOAD_DIR=/app/data/uploads

# ─── WebSocket 配置 ───
# WebSocket 心跳间隔 (秒)
WS_HEARTBEAT_INTERVAL=30

# WebSocket 连接超时 (秒)
WS_TIMEOUT=3600

# ─── 缓存配置 ───
# Redis 连接 (可选，用于会话缓存和消息队列)
# REDIS_URL=redis://redis:6379/0

# ─── 监控配置 ───
# 是否启用 Prometheus metrics
ENABLE_METRICS=false

# 监控端口 (与主端口不同)
METRICS_PORT=9090

# ─── 安全配置 ───
# JWT Secret (用于用户认证)
JWT_SECRET=your-jwt-secret-change-in-production

# Token 过期时间 (小时)
JWT_TOKEN_EXPIRE_HOURS=24

# ─── 邮件配置 (可选) ───
# SMTP 服务器地址
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@ecomind.example.com
# SMTP_PASS=your-smtp-password
# SMTP_TLS=true

# ─── 对象存储 (可选) ───
# MinIO/S3 兼容存储
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=ecomind-staging
# S3_REGION=us-east-1
